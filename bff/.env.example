# Copy to .env (gitignored). Real values never go in this file.

# PostgreSQL. Setup for the server on port 5432 (run once, you will be asked for the postgres password):
#   createdb -h 127.0.0.1 -p 5432 -U postgres pegawai_ai
# then put your own password here. Tables are created automatically when the BFF starts.
DATABASE_URL=postgresql://postgres:GANTI_PASSWORD_ANDA@127.0.0.1:5432/pegawai_ai

# Shared key the Vite proxy sends as X-Pegawai-AI-Key. No /api route uses it anymore; kept for older
# dev proxies. Must equal BFF_API_KEY in frontend/.env.local.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
BFF_API_KEY=

# Signs login tokens. REQUIRED: the BFF refuses to start without it. Must be its own random value,
# at least 32 characters, and different from BFF_API_KEY. Rotating it logs every user out once.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Registration is closed unless this is "true".
# ALLOW_REGISTER=true

# Optional identity for service callers with no bot (e.g. a WhatsApp number not tied to an agent).
# SERVICE_USER_ID=

HERMES_API_URL=http://127.0.0.1:8642
# Default: %LOCALAPPDATA%\hermes
# HERMES_HOME=
# Default: hermes on PATH
# HERMES_BIN=

# --- Connections: Google Drive and Gmail (optional; a missing group just shows "belum diatur" in the app) ---
# Step by step: docs/sprint4/setup-koneksi.md. Real values only in .env, never here.
# Key that encrypts the stored tokens. Without it no connection can be saved.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTIONS_KEY=
# Address you open the app at; the redirect addresses you register at Google are built from it
# (default http://localhost:5173, see the setup doc for the exact addresses).
# PUBLIC_BASE_URL=http://localhost:5173
# Google Cloud OAuth client (type Web) for Drive and Gmail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Key the Hermes agents send to the BFF MCP bridge (/mcp). Left empty, the BFF generates one at startup and writes it here.
MCP_BRIDGE_KEY=
