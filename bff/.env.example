# Copy to .env (gitignored). Real values never go in this file.

# PostgreSQL. Setup for the server on port 5432 (run once, you will be asked for the postgres password):
#   createdb -h 127.0.0.1 -p 5432 -U postgres pegawai_ai
# then put your own password here. Tables are created automatically when the BFF starts.
DATABASE_URL=postgresql://postgres:GANTI_PASSWORD_ANDA@127.0.0.1:5432/pegawai_ai

# Shared key the Vite proxy sends as X-Pegawai-AI-Key. Must equal BFF_API_KEY in frontend/.env.local.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
BFF_API_KEY=

HERMES_API_URL=http://127.0.0.1:8642
# Default: %LOCALAPPDATA%\hermes
# HERMES_HOME=
# Default: hermes on PATH
# HERMES_BIN=
