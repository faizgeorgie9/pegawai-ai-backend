# ==============================================================================
# Pegawai AI Backend - Sanitized Environment Template
# Copy this file to .env and fill in your actual credentials.
# DO NOT COMMIT REAL SECRETS TO GIT.
# ==============================================================================

# Server Network Settings
PORT=8080
HOST=127.0.0.1
ENVIRONMENT=development

# Hermes Agent Local Binary
HERMES_BIN_PATH=%LOCALAPPDATA%\hermes\bin\hermes.exe

# Target Model: DeepSeek V4.1 Flash (Obtain key from Lead)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenCode Go (needs an active Go subscription)
# Also set this in Hermes' own .env (%LOCALAPPDATA%\hermes\.env); Hermes reads that file.
OPENCODE_GO_API_KEY=your_opencode_go_api_key_here

# Fallback Model: GitHub Copilot (if using Copilot authentication)
GITHUB_TOKEN=your_github_personal_access_token_here

# OpenRouter Alternative (optional)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Authorization & Department Security Boundaries
PEGAWAI_AI_SECRET_KEY=dev-pegawai-ai-2026
LOG_LEVEL=INFO

