# =============================================================================
# HERMES AGENT - ENVIRONMENT SECRETS TEMPLATE
# File: .env.example
# Salin file ini menjadi .env dan masukkan kunci rahasia Anda.
# JANGAN PERNAH COMMIT FILE .env YANG BERISI KUNCI ASLI KE GIT REPOSITORY!
# =============================================================================

# 1. Primary Model Providers (Pilih salah satu atau lebih)
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
ANTHROPIC_API_KEY="sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
OPENAI_API_KEY="sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 2. Local / Private Inference (Jika menggunakan Ollama / vLLM lokal)
# OLLAMA_BASE_URL="http://localhost:11434"

# 3. Web Search & Tool Providers (Opsional untuk web research skills)
TAVILY_API_KEY="tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
FIRECRAWL_API_KEY="fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PERPLEXITY_API_KEY="pplx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 4. Custom Profile / Environment Control
# HERMES_PROFILE="default"
# HERMES_HOME="C:\Users\username\AppData\Local\hermes"
